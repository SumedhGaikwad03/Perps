{
  "name": "Perps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "add": "^2.0.9",
    "bun": "^1.4.3",
    "client": "^0.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.9",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
